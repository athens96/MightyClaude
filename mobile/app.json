{
  "expo": {
    "name": "Mighty Claude",
    "slug": "mightyclaude-mobile",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mightyclaude",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0d0d0f",
    "ios": {
      "bundleIdentifier": "dev.mightyclaude.mobile",
      "buildNumber": "2",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "호스트 페어링 QR 코드를 스캔하기 위해 카메라를 사용합니다.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0d0d0f",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA"
      ],
      "predictiveBackGestureEnabled": false,
      "package": "dev.mightyclaude.mobile",
      "versionCode": 2,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.BLUETOOTH",
        "android.permission.WAKE_LOCK"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "호스트 페어링 QR 코드를 스캔하기 위해 카메라를 사용합니다.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": false,
          "cameraPermission": "호스트 페어링 QR 코드를 스캔하기 위해 카메라를 사용합니다.",
          "microphonePermission": false
        }
      ],
      "expo-document-picker",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "호스트 페어링 QR 코드를 스캔하기 위해 카메라를 사용합니다.",
          "microphonePermission": "원격 화면 연결에 WebRTC를 사용합니다. 마이크는 쓰지 않습니다."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0d0d0f",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-screen-orientation",
      "./plugins/with-no-media-projection"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "de3374ab-594e-4138-8948-5bc5b3b084d0"
      }
    },
    "owner": "mightyclaude"
  }
}
