{
  "expo": {
    "name": "MightyClaude",
    "slug": "mightyclaude-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mightyclaude",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0d0d0f",
    "ios": {
      "bundleIdentifier": "dev.mightyclaude.mobile",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "호스트 페어링 QR 코드를 스캔하기 위해 카메라를 사용합니다.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0d0d0f",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA"
      ],
      "predictiveBackGestureEnabled": false,
      "package": "dev.mightyclaude.mobile",
      "versionCode": 1
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "호스트 페어링 QR 코드를 스캔하기 위해 카메라를 사용합니다.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": false,
          "cameraPermission": "호스트 페어링 QR 코드를 스캔하기 위해 카메라를 사용합니다.",
          "microphonePermission": false
        }
      ],
      "expo-document-picker",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0d0d0f",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
