    {
      "name": "revise sends the trimmed feedback as the denial",
      "decision": "revise",
      "feedback": "  2단계를 둘로 나눠 주세요.\nKeep tests first.  ",
      "toolUseId": "toolu_plan_1",
      "expected": {
        "behavior": "deny",
        "message": "The user reviewed your plan and wants changes before any code is written. Stay in plan mode, revise the plan, and call ExitPlanMode again. The user said:\n2단계를 둘로 나눠 주세요.\nKeep tests first.",
        "toolUseID": "toolu_plan_1"
      }
    },
    {
      "name": "cancel denies and interrupts the turn",
      "decision": "cancel",
      "toolUseId": "toolu_plan_1",
      "expected": {
        "behavior": "deny",
        "message": "The user cancelled this plan in Mighty Claude. Do not make any changes; stop and wait for the user's next request.",
        "interrupt": true,
        "toolUseID": "toolu_plan_1"
      }
    },
    {
      "name": "blank revise feedback is refused",
      "decision": "revise",
      "feedback": " \n\t ",
      "toolUseId": "toolu_plan_1",
      "error": true
    }
