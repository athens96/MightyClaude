{
  "planRequests": [
    {
      "name": "plan with the fields the CLI injects from its plan file",
      "request": {
        "type": "control_request",
        "request_id": "req-plan-1",
        "request": {
          "subtype": "can_use_tool",
          "tool_name": "ExitPlanMode",
          "display_name": "Exit plan mode",
          "input": {
            "plan": "# 계획\n\n1. 파서를 추가합니다\n2. Test it",
            "planFilePath": "/Users/me/.claude/plans/quiet-river.md"
          },
          "tool_use_id": "toolu_plan_1",
          "requires_user_interaction": true
        }
      },
      "expected": {
        "canAnswerPlan": true,
        "canAllow": false,
        "plan": "# 계획\n\n1. 파서를 추가합니다\n2. Test it"
      }
    },
    {
      "name": "blank plan cannot be answered as a plan",
      "request": {
        "type": "control_request",
        "request_id": "req-plan-2",
        "request": {
          "subtype": "can_use_tool",
          "tool_name": "ExitPlanMode",
          "input": {
            "plan": "  \n "
          },
          "tool_use_id": "toolu_plan_2",
          "requires_user_interaction": true
        }
      },
      "expected": {
        "canAnswerPlan": false,
        "canAllow": false,
        "plan": null
      }
    },
    {
      "name": "another tool is never a plan",
      "request": {
        "type": "control_request",
        "request_id": "req-plan-3",
        "request": {
          "subtype": "can_use_tool",
          "tool_name": "Bash",
          "input": {
            "command": "ls",
            "plan": "not a plan"
          },
          "tool_use_id": "toolu_plan_3"
        }
      },
      "expected": {
        "canAnswerPlan": false,
        "canAllow": true,
        "plan": null
      }
    }
  ],
