  "dotSize": { "minimum": 6, "range": 14, "cases": [ { "count": 0, "largest": 61, "size": 0 }, { "count": 61, "largest": 61, "size": 20 }, { "count": 1, "largest": 61, "size": 8 }, { "count": 9, "largest": 61, "size": 11 } ] },
  "prompt": "You group one software version's commits into topics for a project overview.\nAnswer in {language}. Reply with JSON only, no prose: {\"topics\":[{\"title\":\"…\",\"summary\":\"…\",\"commits\":[\"sha8\"],\"requests\":[\"id\"]}]}\nRules: 3 to 6 topics; a title of at most 6 words names a user-visible feature or fix; a summary of one sentence says what changed for the user; every commit sha8 belongs to exactly one topic; put a request id under the topic it asked for.\nVersion: {version}\nCommits (sha8 [lanes] scope: subject):\n{commits}\nRequests the user sent (id: text):\n{requests}\nRelease notes:\n{notes}",
  "summaryCases": [
    {
      "name": "plain JSON",
      "commits": [ { "sha": "aaaaaaa1", "lanes": ["mac"] }, { "sha": "bbbbbbb2", "lanes": ["windows"] }, { "sha": "ccccccc3", "lanes": ["phone"] } ],
      "requests": ["p1/r1"],
      "answer": "{\"topics\":[{\"title\":\"Settings\",\"summary\":\"New layout.\",\"commits\":[\"aaaaaaa1\",\"bbbbbbb2\"],\"requests\":[\"p1/r1\"]},{\"title\":\"Phone\",\"summary\":\"Fix.\",\"commits\":[\"ccccccc3\"]}]}",
      "topics": [
        { "title": "Settings", "summary": "New layout.", "lanes": ["mac", "windows"], "commits": ["aaaaaaa1", "bbbbbbb2"], "requests": ["p1/r1"] },
        { "title": "Phone", "summary": "Fix.", "lanes": ["phone"], "commits": ["ccccccc3"], "requests": [] }
      ]
    },
    {
      "name": "a fenced answer with prose around it; unknown shas and ids dropped; leftover commits go to the other topic",
      "commits": [ { "sha": "aaaaaaa1", "lanes": ["mac"] }, { "sha": "bbbbbbb2", "lanes": ["ci"] }, { "sha": "ccccccc3", "lanes": ["etc"] } ],
      "requests": ["p1/r1"],
      "answer": "Here you go:\n```json\n{\"topics\":[{\"title\":\"Tests\",\"summary\":\"Stable {tests}.\",\"commits\":[\"aaaaaaa1\",\"deadbeef\"],\"requests\":[\"p9/r9\"]}]}\n```\nDone.",
      "topics": [
        { "title": "Tests", "summary": "Stable {tests}.", "lanes": ["mac"], "commits": ["aaaaaaa1"], "requests": [] },
        { "title": "@other", "summary": "", "lanes": ["ci", "etc"], "commits": ["bbbbbbb2", "ccccccc3"], "requests": [] }
      ]
    },
    {
      "name": "a topic left with no commit is dropped, a blank title is dropped, long text is cut",
      "commits": [ { "sha": "aaaaaaa1", "lanes": ["windows"] } ],
      "requests": [],
      "answer": "{\"topics\":[{\"title\":\"Ghost\",\"summary\":\"x\",\"commits\":[\"ffffffff\"]},{\"title\":\"  \",\"summary\":\"y\",\"commits\":[\"aaaaaaa1\"]},{\"title\":\"0123456789012345678901234567890123456789EXTRA\",\"summary\":\"short\",\"commits\":[\"aaaaaaa1\"]}]}",
      "topics": [
        { "title": "0123456789012345678901234567890123456789", "summary": "short", "lanes": ["windows"], "commits": ["aaaaaaa1"], "requests": [] }
      ]
    },
    {
      "name": "a commit named twice stays with the first topic",
      "commits": [ { "sha": "aaaaaaa1", "lanes": ["mac"] }, { "sha": "bbbbbbb2", "lanes": ["phone"] } ],
      "requests": [],
      "answer": "{\"topics\":[{\"title\":\"A\",\"summary\":\"a\",\"commits\":[\"aaaaaaa1\",\"bbbbbbb2\"]},{\"title\":\"B\",\"summary\":\"b\",\"commits\":[\"bbbbbbb2\"]}]}",
      "topics": [
        { "title": "A", "summary": "a", "lanes": ["mac", "phone"], "commits": ["aaaaaaa1", "bbbbbbb2"], "requests": [] }
      ]
    },
    { "name": "no JSON", "commits": [ { "sha": "aaaaaaa1", "lanes": ["mac"] } ], "requests": [], "answer": "I could not do it.", "error": true },
    { "name": "no topic keeps a commit", "commits": [ { "sha": "aaaaaaa1", "lanes": ["mac"] } ], "requests": [], "answer": "{\"topics\":[]}", "error": true },
    { "name": "broken JSON", "commits": [ { "sha": "aaaaaaa1", "lanes": ["mac"] } ], "requests": [], "answer": "{\"topics\":[{\"title\":\"A\"", "error": true }
  ],
  "summaryNotes": "A topic title \"@other\" in the expectations stands for the localized workMap.topic.other title with an empty summary. Titles and summaries are trimmed and cut by characters (UTF-16 code units are not used: count Unicode scalar values / text elements as each platform's String does for these ASCII cases)."
}
