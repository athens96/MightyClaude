<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFramework>net10.0</TargetFramework></PropertyGroup>
  <ItemGroup><FrameworkReference Include="Microsoft.AspNetCore.App" /></ItemGroup>
  <ItemGroup><PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" /></ItemGroup>
  <!-- The shared locale files themselves, embedded straight from the repository
       root: Core carries no copy of its own, so it cannot drift from the one
       source, and Locale finds them wherever the process runs from. -->
  <ItemGroup>
    <EmbeddedResource Include="../../../locales/ko.json" LogicalName="MightyClaude.Core.Locales.ko.json" />
    <EmbeddedResource Include="../../../locales/en.json" LogicalName="MightyClaude.Core.Locales.en.json" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../macos/Sources/MightyCore/Resources/Styles/*.json" LogicalName="MightyClaude.Core.Styles.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
