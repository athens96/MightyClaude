<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <Platforms>x64;ARM64</Platforms>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Resource generation/publish tooling is also needed for an unpackaged app. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <ProjectPriFileName>resources.pri</ProjectPriFileName>
    <!-- Ship both the .NET and Windows App SDK runtimes beside the executable. -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsAppSdkUndockedRegFreeWinRTInitialize>true</WindowsAppSdkUndockedRegFreeWinRTInitialize>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../../../assets/icons/MightyClaude.ico</ApplicationIcon>
    <AssemblyName>MightyClaude</AssemblyName>
    <Version>0.2.0</Version>
    <RootNamespace>MightyClaude.WinUI</RootNamespace>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <!-- The update public key and the default manifest address, the way
         scripts/build-macos.sh stamps Info.plist on macOS. A build without
         MightyUpdatePublicKey carries no key and never checks for updates. -->
    <AssemblyMetadata Include="MightyUpdatePublicKey" Value="$(MightyUpdatePublicKey)" Condition="'$(MightyUpdatePublicKey)' != ''" />
    <AssemblyMetadata Include="MightyUpdateManifestURL" Value="$(MightyUpdateManifestUrl)" Condition="'$(MightyUpdateManifestUrl)' != ''" />
  </ItemGroup>
  <ItemGroup>
    <!-- Stable 2026-08-13: https://learn.microsoft.com/windows/apps/windows-app-sdk/release-channels -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <ProjectReference Include="../MightyClaude.Core/MightyClaude.Core.csproj" />
    <Content Include="../../../LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../../assets/icons/MightyClaude.ico" Link="Assets/MightyClaude.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../../assets/icons/mightyclaude.png" Link="Assets/mightyclaude.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../../mods/mighty-bridge/**/*" Link="claude-mods/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- The published app carries the repo-root locale files themselves, so the Windows
         copy cannot drift from the one source; scripts/check-locales.js asserts these links. -->
    <Content Include="../../../locales/ko.json" Link="Locales/ko.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../../locales/en.json" Link="Locales/en.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
