<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework></PropertyGroup>
  <ItemGroup><ProjectReference Include="../MightyClaude.Core/MightyClaude.Core.csproj" /></ItemGroup>
  <!-- The shared execution-graph vectors themselves, embedded straight from the
       repository root: the checks read the same bytes the macOS suite asserts
       against, so the two platforms cannot drift apart. -->
  <ItemGroup>
    <EmbeddedResource Include="../../contracts/relay-vectors.json" LogicalName="MightyClaude.Core.Tests.RelayVectors.json" />
    <EmbeddedResource Include="../../contracts/graph-vectors.json" LogicalName="MightyClaude.Core.Tests.GraphVectors.json" />
    <EmbeddedResource Include="../../contracts/fixtures/model-labels.json" LogicalName="MightyClaude.Core.Tests.ModelLabels.json" />
    <EmbeddedResource Include="../../contracts/fixtures/next-actions.json" LogicalName="MightyClaude.Core.Tests.NextActions.json" />
    <EmbeddedResource Include="../../contracts/fixtures/claude-plan-mode.json" LogicalName="MightyClaude.Core.Tests.ClaudePlanMode.json" />
    <EmbeddedResource Include="../../contracts/fixtures/design-tokens.json" LogicalName="MightyClaude.Core.Tests.DesignTokens.json" />
    <EmbeddedResource Include="../../contracts/fixtures/help-site.json" LogicalName="MightyClaude.Core.Tests.HelpSite.json" />
    <EmbeddedResource Include="../../contracts/fixtures/mobile-structure.json" LogicalName="MightyClaude.Core.Tests.MobileStructure.json" />
    <EmbeddedResource Include="../../contracts/fixtures/tailscale-addresses.json" LogicalName="MightyClaude.Core.Tests.TailscaleAddresses.json" />
    <EmbeddedResource Include="../../contracts/fixtures/delegation-modes.json" LogicalName="MightyClaude.Core.Tests.DelegationModes.json" />
    <EmbeddedResource Include="../../contracts/fixtures/antigravity-permissions.json" LogicalName="MightyClaude.Core.Tests.AntigravityPermissions.json" />
    <EmbeddedResource Include="../../contracts/fixtures/remote-v2/*.json" LogicalName="MightyClaude.Core.Tests.RemoteV2.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../../styles/conformance/**/*.json" LogicalName="MightyClaude.Core.Tests.Styles.%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Every manifest of styles/ and every golden of styles/golden, by folder: a file added there is checked without a line here. -->
    <EmbeddedResource Include="../../../styles/*.json" LogicalName="MightyClaude.Core.Tests.Styles.repository.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../../styles/golden/*.json" LogicalName="MightyClaude.Core.Tests.Styles.golden.%(Filename)%(Extension)" />
    <!-- The test-only manifests the Mac reads from the same files (StyleFixtures.swift), recorded in styles/golden like a style. -->
    <EmbeddedResource Include="../../../styles/fixtures/*.json" LogicalName="MightyClaude.Core.Tests.Styles.fixtures.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
