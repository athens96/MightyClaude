<Project Sdk="Microsoft.NET.Sdk">
  <!-- The C# side of the Rust parity checks (run.ps1): what MightyCode.Core writes, read straight from it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>parity</AssemblyName>
    <RootNamespace>MightyCode.Parity</RootNamespace>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../../../windows/MightyCode.Core/MightyCode.Core.csproj" /></ItemGroup>
  <!-- The page delta's pure rules, compiled from the WinUI file itself (it uses nothing of WinUI), so the vectors cannot drift from it. -->
  <ItemGroup><Compile Include="../../../windows/MightyCode.WinUI/WebDelta.cs" Link="WebDelta.cs" /></ItemGroup>
</Project>
