{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Mighty Code",
  "mainBinaryName": "MightyCode",
  "identifier": "dev.mightycode.tauri",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../windows/web/dist-tauri",
    "beforeDevCommand": { "script": "npm run dev -- --mode tauri --strictPort", "cwd": "../../windows/web" },
    "beforeBuildCommand": { "script": "npm run build -- --mode tauri", "cwd": "../../windows/web" }
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": { "csp": null }
  },
  "bundle": {
    "active": false,
    "icon": ["../../../assets/icons/MightyCode.ico", "../../../assets/icons/mightycode.png", "../../../assets/icons/MightyCode.icns"]
  }
}
