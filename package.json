{
  "name": "mighty-claude",
  "version": "0.1.0",
  "description": "A desktop workspace for Claude Code, Codex and Gemini, with Tailscale remote execution.",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "author": "MightyClaude contributors",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --host 127.0.0.1",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run typecheck && electron-vite build",
    "build:web": "vite build",
    "check": "npm run typecheck && npm test && electron-vite build",
    "package:dir": "npm run build && electron-builder --dir",
    "package:mac": "npm run build && electron-builder --mac",
    "package:win": "npm run build && electron-builder --win",
    "test:ui": "playwright test",
    "test:desktop": "npm run build && node scripts/smoke-desktop.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.273",
    "lucide-react": "^0.468.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "44.4.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.4"
  }
}
