{
"schema":1,
"id":"loop",
"name":"Loop",
"summary":"스케치 → 개요 → 만들기 → 마무리 루프",
"subtitle":"스케치 → 개요 → 만들기 → 마무리",
"placeholders":{"idle":"다음에 할 일을 적고 위에서 행동을 고르세요…","answering":"직접 답하려면 여기에 적고 Enter…"},
"guidance":{"start":"무엇을 할까요? 적으면 스케치부터 시작합니다.","next":"{phase} 단계가 끝났습니다. 다음을 고르세요.","running":"{phase} 진행 중 · 질문이 오면 여기에 보입니다"},
"prerequisites":{"mode":"all","probes":[]},
"phases":[{"id":"sketch","title":"스케치","order":0},{"id":"outline","title":"개요","order":1},{"id":"build","title":"만들기","order":2},{"id":"wrap","title":"마무리","order":3}],
"groups":[{"id":"loop","title":"루프","actions":["sketch-idea","write-outline","build-step","build-split","check-work","wrap-up","find-cause","ask-review"]}],
"actions":[
  {"id":"sketch-idea","title":"아이디어 스케치","help":"생각을 짧은 스케치로 적습니다","prompt":"/loop:sketch-idea {text}","takesText":true,"foldText":"trimOnly","phase":"sketch"},
  {"id":"write-outline","title":"개요 쓰기","help":"할 일을 개요로 나눕니다","prompt":"/loop:write-outline","takesText":false,"phase":"outline"},
  {"id":"build-step","title":"한 단계씩","help":"개요를 한 단계씩 만듭니다","prompt":"/loop:build-step","takesText":false,"phase":"build"},
  {"id":"build-split","title":"나눠 만들기","help":"개요를 여러 손에 나눠 만듭니다","prompt":"/loop:build-split","takesText":false,"phase":"build"},
  {"id":"check-work","title":"확인","help":"만든 것을 확인합니다","prompt":"/loop:check-work","takesText":false,"phase":"wrap"},
  {"id":"wrap-up","title":"마무리","help":"작업을 마무리합니다","prompt":"/loop:wrap-up","takesText":false,"phase":"wrap"},
  {"id":"find-cause","title":"원인 찾기","help":"문제의 원인을 찾습니다","prompt":"/loop:find-cause","takesText":false},
  {"id":"ask-review","title":"검토 부탁","help":"검토를 부탁합니다","prompt":"/loop:ask-review","takesText":false}
],
"aliases":[{"name":"idea","phase":"sketch"},{"name":"toc","phase":"outline"},{"name":"make","phase":"build"},{"name":"end","phase":"wrap"}],
"recognition":{"prefixes":["/loop:"],"lowercase":true},
"rules":{"start":{"kind":"actions","phase":"sketch","actions":["sketch-idea","write-outline"],"resetTitle":"새 스케치"},"phase":{"kind":"lastRecognisedAction","default":"sketch","stateOverrides":[{"sourceIndex":0,"condition":"fileExists","phase":"build"},{"sourceIndex":0,"condition":"allChecked","phase":"wrap"}]},"next":{"kind":"byPhase","map":{"sketch":["write-outline","find-cause"],"outline":["build-step","build-split"],"build":["check-work","find-cause","build-step"],"wrap":["check-work","wrap-up","ask-review"]}},"enter":{"kind":"verbatim"},"recommend":{"kind":"none"},"initialGroup":{"kind":"fixed","group":"loop"}},
"capabilities":[],
"autoAllow":[],
"presentation":{},
"stateSources":{"files":[{"path":"docs/plans/*.md","parser":"markdownChecklist","widget":"progressBar"}],"runEvents":[{"event":"subagent.start","aggregate":"count","widget":"label"}]}
}
